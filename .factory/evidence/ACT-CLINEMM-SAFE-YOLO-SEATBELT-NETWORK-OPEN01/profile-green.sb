(version 1)
(deny default)
(allow process-exec)
(allow process-fork)
(allow signal (target self))
(allow sysctl-read)
(allow mach-lookup)
(allow file-read*)
(allow file-write*
  (subpath "/__NORMALIZED_TEMPROOT__")
  (subpath "/__NORMALIZED_TEMPROOT__")
  (literal "/dev/null")
  (literal "/dev/tty"))
(allow file-read-metadata (subpath "/"))
(allow network*)
