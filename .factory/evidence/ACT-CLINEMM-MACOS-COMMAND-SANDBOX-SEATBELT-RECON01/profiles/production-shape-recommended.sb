    (require-not (subpath "/Volumes/UserData/Users/chistyakov/.ssh"))
    (require-not (subpath "/Volumes/UserData/Users/chistyakov/.aws"))
    (require-not (subpath "/Volumes/UserData/Users/chistyakov/.gnupg"))
    (require-not (subpath "/Volumes/UserData/Users/chistyakov/Projects/SPbNIX/clinemm/.factory/evidence/ACT-CLINEMM-MACOS-COMMAND-SANDBOX-SEATBELT-RECON01/fake-roots/outside"))))
(allow file-write* (literal "/dev/null") (literal "/dev/tty") (subpath "/tmp") (subpath "/private/tmp") (subpath "/private/var/folders") (subpath "/Volumes/UserData/Users/chistyakov/Projects/SPbNIX/clinemm/.factory/evidence/ACT-CLINEMM-MACOS-COMMAND-SANDBOX-SEATBELT-RECON01/fake-roots/inside"))
