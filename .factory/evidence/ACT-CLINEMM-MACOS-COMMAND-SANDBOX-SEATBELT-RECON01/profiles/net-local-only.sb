(version 1)
(deny default)
(allow process-exec)
(allow process-fork)
(allow signal (target self))
(allow sysctl-read)
(allow mach-lookup)
(allow file-read*)
(allow file-write* (literal "/dev/null") (literal "/dev/tty") (subpath "/private/var/folders") (subpath "/tmp") (subpath "/Volumes/UserData/Users/chistyakov/Projects/SPbNIX/clinemm/.factory/evidence/ACT-CLINEMM-MACOS-COMMAND-SANDBOX-SEATBELT-RECON01/profiles"))
(deny network*)
(allow network-outbound (remote ip "localhost:*"))
(allow network-inbound  (local  ip "localhost:*"))
(allow file-read-metadata (subpath "/"))
