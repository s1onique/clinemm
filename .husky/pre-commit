GITLEAKS_BIN=""

if command -v gitleaks >/dev/null 2>&1; then
	GITLEAKS_BIN="$(command -v gitleaks)"
elif [ -x /opt/homebrew/bin/gitleaks ]; then
	GITLEAKS_BIN=/opt/homebrew/bin/gitleaks
elif [ -x /usr/local/bin/gitleaks ]; then
	GITLEAKS_BIN=/usr/local/bin/gitleaks
elif [ -x /home/linuxbrew/.linuxbrew/bin/gitleaks ]; then
	GITLEAKS_BIN=/home/linuxbrew/.linuxbrew/bin/gitleaks
fi

if [ -z "$GITLEAKS_BIN" ]; then
	echo "gitleaks is required for the pre-commit secret scan."
	echo "Install it with: brew install gitleaks"
	echo "Other install options: https://github.com/gitleaks/gitleaks#installing"
	exit 1
fi

"$GITLEAKS_BIN" git --pre-commit --redact --staged --verbose || exit 1

cd apps/vscode && bunx lint-staged

