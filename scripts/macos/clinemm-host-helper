#!/usr/bin/env bash
# clinemm-host-helper — install / uninstall / status for the trusted host helper
# ----------------------------------------------------------------------------
# ACT-CLINEMM-MACOS-TRUSTED-HOST-HELPER01-CORRECTION01
#
# Per-user LaunchAgent installer + status probe for
# `io.clinemm.host-helper`. Developer-tool script: bootstraps the
# helper into the user's launchd domain, leaves unrelated files
# untouched, and never requires sudo.
#
# The helper is a compiled C binary (tools/macos-host-helper/native/helper)
# that calls launch_activate_socket("Listener") and accepts on the
# resulting fd. The Bun/Node server.ts is preserved as a dev-mode
# fallback for local tests.
#
# Usage:
#   scripts/macos/clinemm-host-helper install
#   scripts/macos/clinemm-host-helper uninstall
#   scripts/macos/clinemm-host-helper status
#
# Environment overrides (all optional):
#   CLINEMM_HOST_HELPER_SOCKET     absolute socket path (default: $HOME/.clinemm/host-helper.sock)
#   CLINEMM_HOST_HELPER_LABEL      LaunchAgent label (default: io.clinemm.host-helper)
#   CLINEMM_HOST_HELPER_LAUNCH_AGENTS_DIR  override LaunchAgents dir
#   CLINEMM_HOST_HELPER_LOG_PATH   override log path
#   CLINEMM_HOST_HELPER_BIN_DIR    override compiled-binary install dir
#   CC                            C compiler (default: cc)
# ----------------------------------------------------------------------------
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
HELPER_SRC_DIR="$REPO_ROOT/tools/macos-host-helper/native"
HELPER_C_SRC="$HELPER_SRC_DIR/helper.c"
HELPER_BUILD_SH="$HELPER_SRC_DIR/build.sh"
PLIST_TEMPLATE="$REPO_ROOT/config/macos/io.clinemm.host-helper.plist.template"

LABEL="${CLINEMM_HOST_HELPER_LABEL:-io.clinemm.host-helper}"
SOCKET_PATH="${CLINEMM_HOST_HELPER_SOCKET:-$HOME/.clinemm/host-helper.sock}"
LAUNCH_AGENTS_DIR="${CLINEMM_HOST_HELPER_LAUNCH_AGENTS_DIR:-$HOME/Library/LaunchAgents}"
LAUNCH_AGENT_PLIST="$LAUNCH_AGENTS_DIR/$LABEL.plist"
LOG_PATH="${CLINEMM_HOST_HELPER_LOG_PATH:-$HOME/Library/Logs/clinemm-host-helper.log}"
HELPER_BIN_DIR="${CLINEMM_HOST_HELPER_BIN_DIR:-$HOME/.clinemm/bin}"
HELPER_BIN_PATH="$HELPER_BIN_DIR/clinemm-host-helper"

# Resolve bun path (still used for status probe)
BUN_BIN="${BUN_BIN:-$(command -v bun || true)}"
if [[ -z "${BUN_BIN}" ]]; then
  echo "ERROR: bun not found in PATH. Set BUN_BIN=/full/path/to/bun" >&2
  exit 2
fi

say()  { printf '\033[1;34m[clinemm-host-helper]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[clinemm-host-helper]\033[0m %s\n' "$*" >&2; }
fail() { printf '\033[1;31m[clinemm-host-helper]\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<USAGE
Usage: $0 <install|uninstall|status>

  install     compile helper, write plist, bootstrap LaunchAgent, probe health
  uninstall   bootout LaunchAgent, remove plist, remove stale socket + binary
  status      protocol health probe (does NOT infer from launchctl text alone)
USAGE
}

compile_helper() {
  [[ -f "$HELPER_C_SRC" ]] || fail "helper source not found: $HELPER_C_SRC"
  [[ -f "$HELPER_BUILD_SH" ]] || fail "build.sh not found: $HELPER_BUILD_SH"
  mkdir -p "$HELPER_BIN_DIR"
  # Compile in-place (writes HELPER_SRC_DIR/helper), then copy to HELPER_BIN_PATH.
  # We use a separate copy under ~/.clinemm/bin so the LaunchAgent can
  # refer to a stable location independent of the repo checkout.
  ( cd "$HELPER_SRC_DIR" && "$HELPER_BUILD_SH" )
  install -m 0755 "$HELPER_SRC_DIR/helper" "$HELPER_BIN_PATH"
  say "compiled helper: $HELPER_BIN_PATH"
}

write_plist() {
  mkdir -p "$LAUNCH_AGENTS_DIR" "$HOME/Library/Logs"
  sed \
    -e "s|__SOCKET_PATH__|$SOCKET_PATH|g" \
    -e "s|__HELPER_PATH__|$HELPER_BIN_PATH|g" \
    -e "s|__LOG_PATH__|$LOG_PATH|g" \
    "$PLIST_TEMPLATE" > "$LAUNCH_AGENT_PLIST"
  chmod 0644 "$LAUNCH_AGENT_PLIST"
  say "wrote plist: $LAUNCH_AGENT_PLIST"
}

validate_plist() {
  /usr/bin/plutil -lint "$LAUNCH_AGENT_PLIST" >/dev/null
  say "plist validates: $LAUNCH_AGENT_PLIST"
}

bootstrap_agent() {
  launchctl bootout "gui/$UID/$LABEL" 2>/dev/null || true
  if ! launchctl bootstrap "gui/$UID" "$LAUNCH_AGENT_PLIST"; then
    fail "launchctl bootstrap failed (exit=$?)"
  fi
  say "bootstrapped: gui/$UID/$LABEL"
}

bootout_agent() {
  launchctl bootout "gui/$UID/$LABEL" 2>/dev/null || true
  say "booted-out: gui/$UID/$LABEL"
}

cleanup_socket() {
  if [[ -e "$SOCKET_PATH" ]]; then
    rm -f "$SOCKET_PATH"
    say "removed stale socket: $SOCKET_PATH"
  fi
}

probe_health() {
  local payload
  payload=$(/bin/cat <<'JSON'
{"version":1,"request_id":"status-probe-1","method":"health"}
JSON
)
  CLINEMM_HOST_HELPER_SOCKET="$SOCKET_PATH" "$BUN_BIN" -e '
    import { createConnection } from "node:net"
    const socketPath = process.env.CLINEMM_HOST_HELPER_SOCKET
    if (!socketPath) {
      console.error("CLINEMM_HOST_HELPER_SOCKET not set")
      process.exit(2)
    }
    const payload = JSON.parse(process.argv[1])
    const sock = createConnection(socketPath, () => {
      sock.write(JSON.stringify(payload) + "\n")
    })
    let buf = ""
    const finish = (err) => {
      sock.removeAllListeners()
      if (err) { console.error(err.message); process.exit(1) }
    }
    sock.setTimeout(5000)
    sock.once("timeout", () => finish(new Error("probe timeout")))
    sock.once("error", (err) => finish(err))
    sock.on("data", (chunk) => {
      buf += chunk.toString("utf8")
      const i = buf.indexOf("\n")
      if (i >= 0) {
        try {
          const env = JSON.parse(buf.slice(0, i))
          console.log(JSON.stringify(env))
          process.exit(env.ok ? 0 : 3)
        } catch (cause) {
          finish(new Error("malformed response: " + cause.message))
        }
      }
    })
  ' "$payload"
}

cmd_install() {
  say "install: socket=$SOCKET_PATH label=$LABEL"
  say "helper binary: $HELPER_BIN_PATH"
  say "bun (probe only): $BUN_BIN"
  [[ -f "$HELPER_C_SRC" ]] || fail "helper source not found: $HELPER_C_SRC"
  [[ -f "$PLIST_TEMPLATE" ]] || fail "plist template not found: $PLIST_TEMPLATE"
  compile_helper
  write_plist
  validate_plist
  bootstrap_agent
  local attempt=0
  local max=5
  while (( attempt < max )); do
    sleep 0.5
    if probe_health; then
      say "install: HEALTH_OK"
      return 0
    fi
    attempt=$(( attempt + 1 ))
    warn "install: probe attempt $attempt/$max failed; retrying"
  done
  fail "install: helper did not respond to health probe after $max attempts"
}

cmd_uninstall() {
  say "uninstall: socket=$SOCKET_PATH label=$LABEL"
  bootout_agent
  if [[ -f "$LAUNCH_AGENT_PLIST" ]]; then
    rm -f "$LAUNCH_AGENT_PLIST"
    say "removed plist: $LAUNCH_AGENT_PLIST"
  fi
  cleanup_socket
  if [[ -f "$HELPER_BIN_PATH" ]]; then
    rm -f "$HELPER_BIN_PATH"
    say "removed helper binary: $HELPER_BIN_PATH"
  fi
  say "uninstall: complete"
}

cmd_status() {
  say "status: socket=$SOCKET_PATH label=$LABEL"
  if [[ ! -S "$SOCKET_PATH" ]]; then
    warn "status: socket does not exist (helper not running?)"
    exit 1
  fi
  ls -la "$SOCKET_PATH" || true
  probe_health
}

if (( $# < 1 )); then
  usage
  exit 2
fi

case "$1" in
  install)   shift; cmd_install   "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  status)    shift; cmd_status    "$@" ;;
  -h|--help|help) usage; exit 0 ;;
  *) usage; exit 2 ;;
esac
