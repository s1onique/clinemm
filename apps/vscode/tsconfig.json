{
	"compilerOptions": {
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"jsx": "react",
		"lib": [
			"es2022",
			"DOM"
		],
		"module": "esnext",
		"moduleResolution": "Bundler",
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noUnusedLocals": false,
		"resolveJsonModule": true,
		"rootDir": ".",
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"target": "es2022",
		"typeRoots": [
			"./node_modules/@types",
			"../../node_modules/@types",
			"./src/types"
		],
		"useDefineForClassFields": true,
		"useUnknownInCatchVariables": false,
		"paths": {
			"@/*": [
				"./src/*"
			],
			"@api/*": [
				"./src/core/api/*"
			],
			"@core/*": [
				"./src/core/*"
			],
			"@generated/*": [
				"./src/generated/*"
			],
			"@hosts/*": [
				"./src/hosts/*"
			],
			"@integrations/*": [
				"./src/integrations/*"
			],
			"@packages/*": [
				"./src/packages/*"
			],
			"@services/*": [
				"./src/services/*"
			],
			"@shared/*": [
				"./src/shared/*"
			],
			"@utils/*": [
				"./src/utils/*"
			]
		}
	},
	"include": [
		"./src/**/*"
	],
	"exclude": [
		"node_modules",
		".vscode-test",
		"webview-ui",
		"src/test/e2e/**/*",
		"src/test/scenarios/**/*",
		"src/test/cline-core-vitest-stub.ts",
		"src/test/bun-test-preload.ts",
		// ACT-CLINEMM-EXTENSION-HOST-SESSION-LISTING-ALLOCATION-CAUSALITY01:
		// session-listing causal diagnostic + dedicated vitest harness.
		// The diagnostic modules reach into the live SDK source via
		// @cline-internal/core/... path aliases (declared above), which
		// live outside rootDir `.` for the base TypeScript compile. The
		// dedicated vitest.config.slac01.ts config owns these files;
		// exclude them here so the base tsc emit is not polluted by
		// 9× TS6059 rootDir errors.
		"src/sdk/session-listing-allocation-diagnostic.ts",
		"src/sdk/session-listing-diagnostic-runtime.ts",
		"src/sdk/__tests__/session-listing-allocation-causality01.slac01.test.ts",
		"src/sdk/__tests__/real-local-to-shadow-bridge.c24-c-correction01.test.ts",
		// ACT-CLINEMM-EXTENSION-HOST-WEBVIEW-STATE-SESSION-LISTING-REENUMERATION-REPAIR01-CORRECTION02:
		// real production-class event bus (RuntimeHostEventBus)
		// composition witness. The deep-relative import
		// `../../../../../sdk/packages/core/src/runtime/host/runtime-host-support`
		// is intentional — it resolves the real production class under
		// bun:test, but the file lives outside apps/vscode's rootDir
		// (TS6059). Excluded here; the file runs under `bun test` in
		// the default suite. Same rationale as the
		// `real-local-to-shadow-bridge.c24-c-correction01` bridge
		// exclusion above.
		"src/sdk/__tests__/webview-state-session-listing-cache-coherence-real-production-composition.wvsl-compose-real.test.ts",
		"src/sdk/__tests__/hub-runtime-host.fallback-composition.c24-d.test.ts",
		"src/sdk/__tests__/hub-runtime-host.provenance-epoch.c24-d3.test.ts",
		"src/sdk/__tests__/acl02-runtime-seam.c24-c-bridge.test.ts",
		"src/sdk/__tests__/async-command-ownership-discriminator.aco01.c24-c-bridge.test.ts",
		"src/sdk/__tests__/async-command-ownership-discriminator.aco01-correction03.c24-c-bridge.test.ts",
		"src/sdk/__tests__/application-ownership-projection-coherence.aopc01.c24-c-bridge.test.ts",
		// ACT-CLINEMM-APPLICATION-OWNERSHIP-PROJECTION-COHERENCE01:
		// AOPC02 PHASE-A and its three Phase-A-CORRECTION0N tests are
		// bridge-only (they require the `@cline-internal/core/...`
		// aliases declared only in `tsconfig.c2-4-c-bridge.json`).
		"src/sdk/__tests__/application-ownership-projection-coherence.aopc02.c24-c-bridge.test.ts",
		"src/sdk/__tests__/application-ownership-projection-coherence.aopc02-phase-a-correction01.c24-c-bridge.test.ts",
		"src/sdk/__tests__/application-ownership-projection-coherence.aopc02-phase-a-correction02.c24-c-bridge.test.ts",
		"src/sdk/__tests__/application-ownership-projection-coherence.aopc02-phase-a-correction03.c24-c-bridge.test.ts",
		// ACT-CLINEMM-APPLICATION-OWNERSHIP-CONTROL-COHERENCE01 / AOC02
		// §3: real SdkController producer-object discriminator shares the
		// bridge-only harness shape and runs under the dedicated
		// `vitest.config.c2-4-c-bridge.ts` config (excluded here to
		// match its vitest config counterpart).
		"src/sdk/__tests__/application-ownership-control-coherence.aoc02.c24-c-bridge.test.ts",
		// ACT-CLINEMM-SKIPPED-COMMAND-HOST-RECOVERY01-RESUME01 / SCHR01:
		// host-layer causal discriminator above AgentRuntime. Bridge-only
		// (requires `@cline-internal/core/runtime/host/local-runtime-host`
		// alias declared in `tsconfig.c2-4-c-bridge.json`).
		"src/sdk/__tests__/skipped-command-host-recovery.schr01.test.ts",
		// ACT-CLINEMM-SKIPPED-COMMAND-HOST-RECOVERY01-COMPOSITION01 / SHRC01:
		// real composition discriminator. Bridge-only (same alias
		// surface as SCHR01).
		"src/sdk/__tests__/skipped-command-host-recovery.shrc01.test.ts",
		// ACT-CLINEMM-QUEUED-PROMPT-STOP-RESUME-INTEGRITY01 / QPSR01:
		// Stop/Resume integrity discriminator. Bridge-only.
		"src/sdk/__tests__/queued-prompt-stop-resume-integrity.qpsr01.c24-c-bridge.test.ts",
		// ACT-CLINEMM-BACKGROUND-COMMAND-NOTIFY-ON-TERMINAL01 / BCNT01:
		// Real production wire bridge test — runs under
		// tsconfig.c2-4-c-bridge.json + vitest.config.c2-4-c-bridge.ts
		// to bypass the @cline/core stub alias.
		"src/sdk/__tests__/background-command-notify-on-terminal01.bcnt01-wire.c24-c-bridge.test.ts",
		// ACT-CLINEMM-FOLLOWUP-RESUME-SUBSCRIPTION-PARITY01-CORRECTION03 /
		// FRSP01-C03: bounded P0 cleanup of the test-domain configuration
		// leak that blocked `vscode:prepublish` from producing an exact-
		// head VSIX bound to the C02 runtime repair. The four files
		// below are bridge-only (require the `@cline-internal/core/...`
		// aliases declared in `tsconfig.c2-4-c-bridge.json` only) and
		// were added to the dedicated bridge vitest config but the
		// corresponding BASE tsconfig/vitest excludes were left out,
		// so the BASE tsc emits TS2307 × 6 and the BASE vitest glob
		// emits `Cannot find package '@cline-internal/core/...'`. They
		// run under `vitest.config.c2-4-c-bridge.ts` and are excluded
		// from the base packaging/tsconfig domain by this ACT.
		"src/sdk/__tests__/runtime-shadow-reactivation.rsr01.test.ts",
		"src/sdk/__tests__/runtime-shadow-reactivation.rsr01-correction01.test.ts",
		"src/sdk/__tests__/runtime-followup-resume-subscription-parity.frsp01.test.ts",
		"src/sdk/__tests__/runtime-followup-resume-subscription-parity.frsp01-correction01.test.ts",
		// ACT-CLINEMM-FACTORIZE-F1-WORKING-CONTEXT-CARRIER-AUTHORITY01
		// (seventy-seventh-pass, CORRECTION02 real-producer-witness):
		// full-composition witness — REAL factory + REAL
		// `compactSessionMessages` + REAL W estimator. Bridge-only
		// (requires the `@cline-internal/core/extensions/context/
		// compaction` alias declared only in
		// `tsconfig.c2-4-c-bridge.json`).
		"src/sdk/__tests__/sdk-compaction-w-publish-red01-real-producer.test.ts",
		// ACT-CLINEMM-PROVIDER-INSTANCE-IDENTITY-IMPLEMENTATION01 / R3-R5
		// (persistence phase): the instance-store / typed-projector /
		// instance-secret tests run under the dedicated
		// `vitest.config.c2-4-c-bridge.ts` config and are excluded
		// here to keep the base config's @cline/core stub alias in
		// scope (the bridge config has the
		// `@cline-internal/core/...` aliases the REAL projector
		// needs).
		"src/sdk/instance-store/instances-store.test.ts",
		"src/sdk/instance-store/typed-projector.test.ts",
		"src/shared/storage/__tests__/instance-secret.test.ts",
		// ACT-CLINEMM-PROVIDER-INSTANCE-IDENTITY-IMPLEMENTATION01 / R4
		// (durable): real StateManager.setInstanceSecret /
		// getInstanceSecret / flushPendingState roundtrip. Runs in
		// the bridge config alongside the schema tests for
		// consistency with the recon-phase pre-existing infra
		// quirk.
		"src/core/storage/__tests__/state-manager-instance-secret-durable.test.ts",
		// ACT-CLINEMM-PROVIDER-INSTANCE-IDENTITY-FOUNDATION01-R1A-RED01
		// / PIIF01: real-production-seam DIAGNOSTIC current-seam
		// witness. Imports the bridge-only `@cline-internal/core/
		// runtime/host/local-runtime-host` alias, which only exists
		// in `tsconfig.c2-4-c-bridge.json`. Runs under that bridge
		// config; excluded here to keep the base packaging/tsconfig
		// domain free of internal aliases (matches the existing
		// PIIF R2p / R-REPLACE / R4-RR pattern below).
		"src/sdk/__tests__/provider-instance-identity-r1a-red.piif01.test.ts",
		// ACT-CLINEMM-PROVIDER-INSTANCE-IDENTITY-FOUNDATION01-R2-STRATEGY-B
		// / PIIF01: explicit instance-apply Strategy B contract
		// test. Same bridge-only alias dependency as R1A-RED01.
		// Runs under `tsconfig.c2-4-c-bridge.json`; excluded here.
		"src/sdk/__tests__/provider-instance-identity-r2-strategy-b.piif01.test.ts",
		// ACT-CLINEMM-PROVIDER-INSTANCE-IDENTITY-IMPLEMENTATION01 / R-REPLACE
		// (fourteenth-reviewer C1 "GO TO R-REPLACE"): the real
		// composed-lifecycle witness drives
		// SdkSessionConfigBuilder.build + SdkSessionLifecycle.replaceActiveSession
		// together with mocked VscodeSessionHost.create /
		// StateManager. Runs in the bridge config for consistency
		// with R2p / R5.
		"src/sdk/__tests__/provider-instance-identity-r-replace-real-lifecycle.piif01.test.ts",
		// ACT-CLINEMM-PROVIDER-INSTANCE-IDENTITY-IMPLEMENTATION01 / R4-RR
		// (fifteenth reviewer, C1 "GO TO FOUNDATION FINAL
		// QUALIFICATION", this pass): persisted instance-secret
		// RELOAD witness. Tests the lowest production reload seam
		// (fresh ClineFileStorage from same secrets.json disk path).
		// Bridge-only for consistency with the R4-D durable suite.
		"src/sdk/__tests__/provider-instance-identity-r4-reload-read.piif01.test.ts",
		// ACT-CLINEMM-DOGFOOD-BUILD-INTEGRATION-REPAIR01 / B1:
		// The Seatbelt observer test imports `./cline-core-vitest-stub`
		// via a relative path to drive the live Seatbelt singleton. The
		// stub in turn re-exports raw SDK source from `sdk/packages/core/...`
		// (file-read, command-policy, sandbox backends, etc.) which then
		// pulls the entire SDK source tree into the apps/vscode
		// compilation unit under rootDir `.` — producing 306× TS6059.
		//
		// The stub IS already excluded (line 73) but `tsc` re-resolves
		// it via transitive relative import from this consumer. Excluding
		// the consumer (which is test-only and is run via vitest under
		// `bun run test:vitest`) breaks the leak while leaving every
		// vitest, bun, and integration test harness unaffected.
		"src/sdk/__tests__/seatbelt-network-live-downstream-recon01.c1-observer.test.ts"
	]
}
