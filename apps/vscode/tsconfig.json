{
	"compilerOptions": {
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"jsx": "react",
		"lib": [
			"es2022",
			"DOM"
		],
		"module": "esnext",
		"moduleResolution": "Bundler",
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noUnusedLocals": false,
		"resolveJsonModule": true,
		"rootDir": ".",
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"target": "es2022",
		"typeRoots": [
			"./node_modules/@types",
			"../../node_modules/@types",
			"./src/types"
		],
		"useDefineForClassFields": true,
		"useUnknownInCatchVariables": false,
		"paths": {
			"@/*": [
				"./src/*"
			],
			"@api/*": [
				"./src/core/api/*"
			],
			"@core/*": [
				"./src/core/*"
			],
			"@generated/*": [
				"./src/generated/*"
			],
			"@hosts/*": [
				"./src/hosts/*"
			],
			"@integrations/*": [
				"./src/integrations/*"
			],
			"@packages/*": [
				"./src/packages/*"
			],
			"@services/*": [
				"./src/services/*"
			],
			"@shared/*": [
				"./src/shared/*"
			],
			"@utils/*": [
				"./src/utils/*"
			]
		}
	},
	"include": [
		"./src/**/*"
	],
	"exclude": [
		"node_modules",
		".vscode-test",
		"webview-ui",
		"src/test/e2e/**/*",
		"src/test/scenarios/**/*",
		"src/test/cline-core-vitest-stub.ts",
		"src/test/bun-test-preload.ts",
		"src/sdk/__tests__/real-local-to-shadow-bridge.c24-c-correction01.test.ts",
		"src/sdk/__tests__/hub-runtime-host.fallback-composition.c24-d.test.ts",
		"src/sdk/__tests__/hub-runtime-host.provenance-epoch.c24-d3.test.ts",
		"src/sdk/__tests__/acl02-runtime-seam.c24-c-bridge.test.ts",
		"src/sdk/__tests__/async-command-ownership-discriminator.aco01.c24-c-bridge.test.ts",
		"src/sdk/__tests__/async-command-ownership-discriminator.aco01-correction03.c24-c-bridge.test.ts",
		"src/sdk/__tests__/application-ownership-projection-coherence.aopc01.c24-c-bridge.test.ts",
		// ACT-CLINEMM-APPLICATION-OWNERSHIP-PROJECTION-COHERENCE01:
		// AOPC02 PHASE-A and its three Phase-A-CORRECTION0N tests are
		// bridge-only (they require the `@cline-internal/core/...`
		// aliases declared only in `tsconfig.c2-4-c-bridge.json`).
		"src/sdk/__tests__/application-ownership-projection-coherence.aopc02.c24-c-bridge.test.ts",
		"src/sdk/__tests__/application-ownership-projection-coherence.aopc02-phase-a-correction01.c24-c-bridge.test.ts",
		"src/sdk/__tests__/application-ownership-projection-coherence.aopc02-phase-a-correction02.c24-c-bridge.test.ts",
		"src/sdk/__tests__/application-ownership-projection-coherence.aopc02-phase-a-correction03.c24-c-bridge.test.ts",
		// ACT-CLINEMM-APPLICATION-OWNERSHIP-CONTROL-COHERENCE01 / AOC02
		// §3: real SdkController producer-object discriminator shares the
		// bridge-only harness shape and runs under the dedicated
		// `vitest.config.c2-4-c-bridge.ts` config (excluded here to
		// match its vitest config counterpart).
		"src/sdk/__tests__/application-ownership-control-coherence.aoc02.c24-c-bridge.test.ts",
		// ACT-CLINEMM-SKIPPED-COMMAND-HOST-RECOVERY01-RESUME01 / SCHR01:
		// host-layer causal discriminator above AgentRuntime. Bridge-only
		// (requires `@cline-internal/core/runtime/host/local-runtime-host`
		// alias declared in `tsconfig.c2-4-c-bridge.json`).
		"src/sdk/__tests__/skipped-command-host-recovery.schr01.test.ts",
		// ACT-CLINEMM-SKIPPED-COMMAND-HOST-RECOVERY01-COMPOSITION01 / SHRC01:
		// real composition discriminator. Bridge-only (same alias
		// surface as SCHR01).
		"src/sdk/__tests__/skipped-command-host-recovery.shrc01.test.ts",
		// ACT-CLINEMM-QUEUED-PROMPT-STOP-RESUME-INTEGRITY01 / QPSR01:
		// Stop/Resume integrity discriminator. Bridge-only.
		"src/sdk/__tests__/queued-prompt-stop-resume-integrity.qpsr01.c24-c-bridge.test.ts",
		// ACT-CLINEMM-FOLLOWUP-RESUME-SUBSCRIPTION-PARITY01-CORRECTION03 /
		// FRSP01-C03: bounded P0 cleanup of the test-domain configuration
		// leak that blocked `vscode:prepublish` from producing an exact-
		// head VSIX bound to the C02 runtime repair. The four files
		// below are bridge-only (require the `@cline-internal/core/...`
		// aliases declared in `tsconfig.c2-4-c-bridge.json` only) and
		// were added to the dedicated bridge vitest config but the
		// corresponding BASE tsconfig/vitest excludes were left out,
		// so the BASE tsc emits TS2307 × 6 and the BASE vitest glob
		// emits `Cannot find package '@cline-internal/core/...'`. They
		// run under `vitest.config.c2-4-c-bridge.ts` and are excluded
		// from the base packaging/tsconfig domain by this ACT.
		"src/sdk/__tests__/runtime-shadow-reactivation.rsr01.test.ts",
		"src/sdk/__tests__/runtime-shadow-reactivation.rsr01-correction01.test.ts",
		"src/sdk/__tests__/runtime-followup-resume-subscription-parity.frsp01.test.ts",
		"src/sdk/__tests__/runtime-followup-resume-subscription-parity.frsp01-correction01.test.ts",
		// ACT-CLINEMM-DOGFOOD-BUILD-INTEGRATION-REPAIR01 / B1:
		// The Seatbelt observer test imports `./cline-core-vitest-stub`
		// via a relative path to drive the live Seatbelt singleton. The
		// stub in turn re-exports raw SDK source from `sdk/packages/core/...`
		// (file-read, command-policy, sandbox backends, etc.) which then
		// pulls the entire SDK source tree into the apps/vscode
		// compilation unit under rootDir `.` — producing 306× TS6059.
		//
		// The stub IS already excluded (line 73) but `tsc` re-resolves
		// it via transitive relative import from this consumer. Excluding
		// the consumer (which is test-only and is run via vitest under
		// `bun run test:vitest`) breaks the leak while leaving every
		// vitest, bun, and integration test harness unaffected.
		"src/sdk/__tests__/seatbelt-network-live-downstream-recon01.c1-observer.test.ts"
	]
}
