# Ignore docs
docs/**
old_docs/**

# Fix issue where codicons don't get packaged (https://github.com/microsoft/vscode-extension-samples/issues/692)
!node_modules/@vscode/codicons/dist/codicon.css
!node_modules/@vscode/codicons/dist/codicon.ttf

# Include default themes JSON files used in getTheme
!src/integrations/theme/default-themes/**

# Include icons
!assets/icons/**

# ACT-CLINEMM-COMPLETION-AUTHORITY-ELM-SHADOW02-CORRECTION03 (PACKAGING-DISCOVERY):
# The Elm kernel bundle is generated by elm make and is intentionally
# excluded from git by apps/vscode/elm/completion-authority/.gitignore
# (`vendor/*.js`, `vendor/*.sha256`). vsce applies .gitignore
# semantics during file DISCOVERY, before .vscodeignore runs — so
# any kernel JS living under the nested .gitignore filter is
# invisible to vsce and CANNOT be resurrected by a later
# `.vscodeignore !negation`. (The previous
# ACT-CLINEMM-COMPLETION-AUTHORITY-ELM-SHADOW01-PACKAGING-RESOURCE-FIX
# attempted that exact negation and the canonical exact-file verifier
# still failed: the package tree preview showed the
# `elm/completion-authority/` subtree but the kernel JS itself
# was never in the VSIX.)
#
# The bounded fix is to stage the kernel into a NON-gitignored,
# package-owned runtime-asset directory inside the temporary
# dogfood worktree immediately before `vsce package` runs.
# The activation code in apps/vscode/src/extension.ts:activate
# loads exactly this path (`runtime-assets/completion-authority.js`)
# relative to context.extensionUri.fsPath when
# CLINEMM_COMPLETION_AUTHORITY_ELM_SHADOW=1 is set, so the runtime
# artifact must be present at that exact VSIX location. The staging
# is implemented in
# scripts/build_dogfood_vsix_lib.py > stage_elm_kernel_runtime_asset.
# The build itself is reproducible via
# apps/vscode/elm/completion-authority/scripts/build-elm.sh.
!runtime-assets/completion-authority.js
!runtime-assets/completion-authority.js.sha256

